{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apuntador",
  "version": "0.2.1",
  "identifier": "net.wefaber.apuntador",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Apuntador",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#FFFFFF",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,WebRtcHideLocalIpsWithMdns"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNkU4M0M0QzRCMzgyQzQKUldURWdyUEV4SU51UWNuQ25hVWFocFVEcHNnKzlrSytiUGh4SytySFcyWDhzbEhHM0ZzTTM1UEwK",
      "endpoints": [
        "https://github.com/wefaber/wefaber-teleprompter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
